# Copy this file to ".env" (same folder) and fill in real values.
# ".env" itself is git-ignored — never commit real secrets.

# Required — backend calls OpenAI directly
OPENAI_API_KEY=sk-proj-...

# Optional — only needed if you use the /prompt editor page.
# Get a free key at https://jsonbin.io
JSONBIN_API_KEY=
JSONBIN_BIN_ID=
