# Copy this file to ".env" (same folder) and fill in real values.
# ".env" itself is git-ignored — never commit real secrets.

# Required — backend calls OpenAI directly
OPENAI_API_KEY=sk-proj-...

# The system prompt is stored in SQLite now (backend/data/app.db), not a
# third-party service — no JSONBin key needed anymore.

# Protects /prompt (the AI system-prompt editor). Set a real password to
# require login before anyone can view or edit the prompt. Leave this
# BLANK to turn the whole gate off — /prompt is then wide open to anyone,
# no login at all. Toggle any time by setting/clearing this value; nothing
# else needs to change.
PROMPT_ADMIN_PASSWORD=

# Optional — signs the /prompt login session cookie. If unset, a random
# secret is generated per process start, which works fine but logs
# everyone out on every restart/redeploy. Set this for sessions that
# survive a restart. Generate one with: openssl rand -hex 32
PROMPT_SESSION_SECRET=

# Required to unlock /prompt. Shared between frontend and backend — the
# backend's own /api/prompt rejects every request without this exact
# value, so the frontend's password gate can't be bypassed by hitting the
# backend's port directly. Same value on both sides. Generate one with:
# openssl rand -hex 32
INTERNAL_API_SECRET=
