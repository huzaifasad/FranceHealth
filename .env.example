# Copy this file to ".env" (same folder) and fill in real values.
# ".env" itself is git-ignored — never commit real secrets.

# Required — backend calls OpenAI directly
OPENAI_API_KEY=sk-proj-...

# The system prompt is stored in SQLite now (backend/data/app.db), not a
# third-party service — no JSONBin key needed anymore.

# Required to unlock /prompt (the AI system-prompt editor) — pick a real
# password. Without this set, /prompt stays permanently locked (fails
# closed, not open).
PROMPT_ADMIN_PASSWORD=

# Optional — signs the /prompt login session cookie. If unset, a random
# secret is generated per process start, which works fine but logs
# everyone out on every restart/redeploy. Set this for sessions that
# survive a restart. Generate one with: openssl rand -hex 32
PROMPT_SESSION_SECRET=
